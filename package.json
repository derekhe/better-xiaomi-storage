{
  "name": "better-xiaomi-storage",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "映集 — Xiaomi Smart Storage gallery with local AI photo cleanup",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/derekhe/better-xiaomi-storage.git"
  },
  "homepage": "https://github.com/derekhe/better-xiaomi-storage#readme",
  "bugs": {
    "url": "https://github.com/derekhe/better-xiaomi-storage/issues"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "vitest run",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "prepare:liqe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-liqe.ps1",
    "package": "npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "beforePack": "./scripts/validate-runtime.cjs",
    "appId": "io.github.derekhe.better-xiaomi-storage",
    "productName": "映集",
    "files": [
      "dist/renderer/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/smart-storage-client.cjs",
      "electron/standalone-session.cjs",
      "electron/device-certificate.cjs",
      "electron/cleanup-trash.cjs",
      "electron/cleanup-cache.cjs",
      "electron/background-analysis.cjs",
      "electron/analysis-preload.cjs",
      "electron/liqe.cjs",
      "electron/liqe_worker.py",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/xiaomi-runtime",
        "to": "xiaomi-runtime"
      },
      {
        "from": "vendor/liqe-runtime",
        "to": "liqe-runtime",
        "filter": ["**/*", "!Scripts/**", "!pyvenv.cfg", "!share/**", "!.lock", "!*.partial", "!*.download", "!**/__pycache__/**"]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/brand/app.ico",
      "target": "nsis",
      "artifactName": "better-xiaomi-storage-${version}-setup.${ext}"
    },
    "nsis": {
      "installerIcon": "public/brand/app.ico",
      "uninstallerIcon": "public/brand/app.ico"
    }
  }
}
